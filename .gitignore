# Signing key material — never committed, DEV or production.
.secrets/

# Generated per-install env files (real secrets) — env.template is the only
# tracked env file.
*.env
!env.template

# Anything a local drill/test writes under a generated install dir.
secrets/

# Local CLI build output. Source stays in cli/. The npm package is not part of
# the signed install bundle.
/privos
/cli/node_modules/
/cli/dist/
/cli/*.tgz
/cli/LICENSE
