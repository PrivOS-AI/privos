# PrivOS self-hosted bundle — environment file
#
# install.sh writes the REAL `.env` (mode 0600, secrets included) next to
# compose.yml. This template documents every knob; it is never used as-is —
# secrets are generated locally by install.sh and are NEVER shipped filled in.
# Do not commit a filled-in .env anywhere.

# ---------------------------------------------------------------------------
# Core placement
# ---------------------------------------------------------------------------

# Absolute path install.sh was run with (--dir, default /opt/privos). Every
# bind mount in compose.yml is anchored on this value.
#
# macOS (Docker Desktop): the default is ~/.privos and the install runs without
# sudo. The directory then holds only compose.yml, compose.desktop.yml, .env,
# secrets/ and the notices; every data directory is a named volume
# (`<PRIVOS_PROJECT>-mongo`, `-rustfs`, `-hub-lib`, ...) defined by
# compose.desktop.yml, so nothing under it needs chown. Back them up with
# `docker run --rm -v <volume>:/v alpine tar -C /v -cf - .`.
PRIVOS_DIR=/opt/privos

# Compose project / container-name prefix and the external Docker network
# install.sh pre-creates (`docker network create`). Stable names so re-runs,
# --upgrade and --uninstall can always find "our" resources.
PRIVOS_PROJECT=privos
PRIVOS_NETWORK=privos-sandbox-net

# Dedicated bridge network for agent VM containers (sandbox-proxy's
# VM_NETWORK) — kept separate from PRIVOS_NETWORK so agent VMs can never
# reach Mongo/Redis/RustFS directly. Also pre-created by install.sh
# (`docker network create --opt com.docker.network.bridge.name=...`); the
# fixed bridge interface name lets docker-user-rules.sh match agent-VM
# traffic without resolving an opaque `br-<network-id>` name at runtime.
PRIVOS_AGENT_NETWORK=privos-agent-net

# Image tag pulled for hub/sandbox-board/sandbox-proxy/sandbox-vm (digests are
# baked into compose.yml at publish time; this only selects the tag family).
PRIVOS_STACK_VERSION=

# Public URL the hub is reachable at (--url, e.g. https://privos.example.com
# or http://<host-ip>:3000 for a bare-IP install). Re-running install.sh with
# a different --url rewrites this and restarts the hub. Locally executed
# marketplace apps call the hub at this URL, so it must be reachable from
# containers on this host (a localhost URL breaks local app execution).
PRIVOS_ROOT_URL=

# Stable per-install identity used as DEPLOYMENT_ID / COLLOC_HUB_ID /
# KNOWLEDGE_WORKSPACE_ID. Generated once by install.sh (uuid), never rotated.
PRIVOS_DEPLOYMENT_ID=

# If you front the hub with your OWN reverse proxy (nginx, Caddy, a Cloudflare
# tunnel, ...) instead of reaching it directly, the hub needs to know it can
# trust THAT proxy's X-Forwarded-For/X-Real-IP headers — otherwise every
# request path that keys off the client's IP (login-attempt lockout, rate
# limits) sees only the proxy's own address for every visitor. Comma-separated
# IPv4/IPv6 CIDRs or single addresses of peers to trust; leaving this unset
# trusts every peer's headers (the pre-existing default, unchanged — a stock
# install with no reverse proxy needs no change here). The bundled default
# below trusts loopback plus the whole Docker 172.16.0.0/12 bridge-pool range,
# which conveniently covers this compose stack's own containers and a reverse
# proxy container running on the SAME host, but is imprecise: a LAN that
# itself hands out addresses inside 172.16.0.0/12 would also be trusted.
# Pinning your compose network's actual subnet (`docker network inspect
# ${PRIVOS_NETWORK:-privos-sandbox-net}`) is the stricter alternative. A
# reverse proxy on a DIFFERENT host must have its address added explicitly —
# it is never covered by the default.
PRIVOS_HUB_TRUSTED_PROXIES=127.0.0.0/8,::1,172.16.0.0/12

# Agent container resource caps. Community installs run agent containers
# uncapped by default (0 = no cap for that limit); the host belongs to one
# owner. Set positive values to stop a runaway agent from taking the whole
# host: MB for memory, whole or fractional CPUs, integer PIDs. POOL_* applies
# to per-project cores, COLLOC_* to the shared collocation core.
#POOL_CONTAINER_MEMORY_MB=0
#POOL_CONTAINER_CPUS=0
#POOL_CONTAINER_PIDS_LIMIT=0
#COLLOC_CONTAINER_MEMORY_MB=0
#COLLOC_CONTAINER_CPUS=0
#COLLOC_CONTAINER_PIDS_LIMIT=0

# Concurrent published-file reads per hub process (effectively uncapped by
# default; the content route streams). Lower it only on a very small host.
#PRIVOS_PUBLISHED_FILES_MAX_CONCURRENT_READS=10000

# ---------------------------------------------------------------------------
# Ports (see docs/self-hosted-install.md — only the hub is reachable off-host)
# ---------------------------------------------------------------------------

# Published on 0.0.0.0. --hub-port / PRIVOS_HUB_PORT at install time.
PRIVOS_HUB_PORT=3000

# Loopback-only (127.0.0.1) — operator/installer health checks only.
PRIVOS_BOARD_PORT=8556
PRIVOS_PROXY_PORT=8557
PRIVOS_RUSTFS_PORT=9000

# Loopback-only host-port range for the sandbox VM pool (legacy pool mode —
# see RENDERER-DIFF.md). --vm-port-range / PRIVOS_VM_PORT_RANGE.
PRIVOS_VM_PORT_RANGE=30000-30999

# Operator-only comma-separated allowlist letting agent VM containers, and
# the sandbox's own WebFetch/WebSearch tools, reach specific private-range
# destinations — e.g. an internal LAN service, or a LAN-hosted LLM endpoint
# (see "LAN / private LLM endpoints" below) — despite the default-deny on
# RFC1918/carrier-grade-NAT/link-local egress. --egress-allowlist /
# PRIVOS_EGRESS_ALLOWLIST. Never loopback or link-local (127.0.0.0/8,
# 169.254.0.0/16, including the 169.254.169.254 cloud-metadata address) —
# neither layer below ever admits those, regardless of this setting. Empty by
# default (no private-range access). compose.yml forwards this SAME value
# (read from this one .env file) into sandbox-proxy and sandbox-board, so
# both layers below always agree on what is listed, even though they enforce
# it differently and independently:
#   - The host firewall (docker-user-rules.sh, --egress-allowlist) — IPv4/TCP
#     only (UDP, ICMP and IPv6 entries are not filtered by it), and only ever
#     admits IPv4 CIDR/host entries (e.g. 10.20.0.0/16); a malformed entry
#     aborts the install with no partial change.
#   - The sandbox's own in-process WebFetch/WebSearch guard
#     (packages/agentic-sdk/src/lib/outbound-host-guard.ts), which
#     additionally accepts exact hostname entries (e.g.
#     internal-api.corp.example) the firewall cannot match, and forwards into
#     every agent VM/collocation core it spawns (never overridable by a
#     room). REQUIRES a sandbox image built from a commit that includes the
#     operator-allowlist WebFetch guard — an older image ignores this
#     variable entirely and keeps refusing every private-range fetch.
# Never add PrivOS's own internal service names here (redis, mongo, proxy,
# board, ...); those stay blocked regardless of this setting.
PRIVOS_EGRESS_ALLOWLIST=

# Agent VM network egress mode: open | enforce. `open` (default) is today's
# behaviour. `enforce` makes docker-user-rules.sh drop everything leaving the
# agent bridge except the sandbox proxy (its forward port and API port) and
# Mongo, and routes VM web traffic through the proxy forward listener. It needs
# its own operator decision: agents lose direct internet access (package
# installs, arbitrary web reads) until hosts are allowed. There is no built-in
# allowlist. Un-credentialed hosts pass the proxy forward listener only when an
# admin lists them in the hub setting PrivOSSandbox_Egress_Allowed_Hosts; hosts
# bound to a vault credential are never allowlisted implicitly.
# Unknown values make docker-user-rules.sh abort without changing any rule.
VM_EGRESS_MODE=open
# Sandbox proxy forward listener port (agent network only).
VM_EGRESS_FORWARD_PORT=8558
# Vault v2 switch for the sandbox proxy. Empty = off.
VAULT_V2_ENABLED=

# ---------------------------------------------------------------------------
# LAN / private LLM endpoints (BYO, including fully air-gapped installs)
#
# Roxane (the built-in gateway provider) needs internet. To point PrivOS at
# an LLM on your own network instead — Ollama, vLLM, LiteLLM, or any other
# Anthropic-/OpenAI-compatible server on a private address, including on a
# host with NO internet access at all — three things have to line up:
#   1. List that endpoint's IPv4 address/CIDR in PRIVOS_EGRESS_ALLOWLIST
#      above (private ranges only — never loopback or link-local). That one
#      entry opens both the host firewall and the sandbox's LLM relay/WebFetch
#      to it. An exact hostname entry opens only the sandbox layer: the
#      firewall ignores hostnames, and sandbox-proxy's own traffic crosses it
#      (see the sandbox-proxy note in compose.yml), so the relay would still be
#      dropped. If you point PrivOS at a hostname, list its IP here as well.
#   2. Point PrivOS at it: either the ANTHROPIC_API_KEY/OPENAI_API_KEY/
#      PRIVOS_LLM_BASE_URL/PRIVOS_LLM_MODEL/PRIVOS_LLM_SMALL_MODEL keys below
#      (pre-seed, before first boot), or a custom provider added from the UI
#      after boot.
#   3. Once you've explicitly configured or imported that endpoint as a
#      provider this way, it is not silently replaced by the Roxane overlay
#      after online activation — Roxane stays available alongside it, never
#      instead of it.
# REQUIRES sandbox images built from a commit that includes both the
# operator-allowlist WebFetch guard AND the LAN-LLM-provider change described
# above; on an older image, step 1 has no effect and step 3 does not hold —
# activating online silently moves a private-address BYO install onto Roxane
# at $0 credit. Nothing here promises a path beyond exactly this: a private
# Anthropic-/OpenAI-compatible endpoint you explicitly listed and configured.
#
# Also note: sandbox-proxy's default outbound route runs over the
# privos-agent-net bridge (its VM_NETWORK), so its own egress to a private
# destination is subject to the SAME agent-egress DROP rules as an agent VM's
# — it is not somehow exempt — until that destination is allowlisted above.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MongoDB (single-member replica set, generated locally)
# ---------------------------------------------------------------------------

MONGO_ROOT_USER=privos
MONGO_ROOT_PASSWORD=
# Resolved by install.sh from MONGO_ROOT_USER/PASSWORD — not hand-edited.
MONGO_URL=
MONGO_OPLOG_URL=
MONGODB_URL=
PRIVOS_MONGO_CACHE_GB=1
PRIVOS_MONGO_MEM=1g
PRIVOS_MONGO_CPUS=2

# ---------------------------------------------------------------------------
# RustFS (single node — bundle-only, see RENDERER-DIFF.md)
# ---------------------------------------------------------------------------

RUSTFS_ROOT_USER=privos-root
RUSTFS_ROOT_PASSWORD=
# Scoped service account rustfs-init.sh provisions for hub/board/proxy.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=privos
PRIVOS_RUSTFS_MEM=512m
PRIVOS_RUSTFS_CPUS=1

# ---------------------------------------------------------------------------
# Hub admin + secrets (all generated locally by install.sh)
# ---------------------------------------------------------------------------

ADMIN_PASS=
ADMIN_EMAIL=admin@localhost
REG_TOKEN=
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SANDBOX_API_KEY=
# Encrypts the sandbox proxy's egress-credential catalog at rest — without it
# every bot-key/catalog write fails with "CATALOG_SECRET_KEY is not set".
CATALOG_SECRET_KEY=
# Fail-closed usage-authorization gate (matches the fleet default).
SERVICE_USAGE_AUTHORIZATION_FAIL_CLOSED=true
# encrypted_secrets vault key (32 raw bytes, base64) — without it the hub
# falls back to a plaintext secret store and refuses to pair an App Cluster.
PRIVOS_SECRET_STORE_KEY=
PRIVOS_HUB_MEM=2g
PRIVOS_HUB_CPUS=2
PRIVOS_BOARD_MEM=512m
PRIVOS_BOARD_CPUS=1
PRIVOS_PROXY_MEM=512m
PRIVOS_PROXY_CPUS=1

# ---------------------------------------------------------------------------
# LLM routing
#
# Activation (https://client.privos.io/self-hosted/activate) is required
# before this install is usable at all — see install.sh's printed request
# code. Once activated, the built-in Roxane provider (models gauga/issus/
# granic, served by the PrivOS gateway) is the default, starting with $0
# credit; top up any time at client.privos.io. Roxane cannot be deleted or
# edited — this is enforced by the hub, not by anything in this file.
#
# The four keys below are an OPTIONAL pre-seed, not a required setup step.
# If you fill them in before first boot, the sandbox imports them ONCE as a
# custom provider (never overwriting one you later edit by hand). If no
# default provider has been chosen yet, that imported provider becomes the
# default, so an install with its own key keeps answering while Roxane has
# $0 credit. Roxane stays listed; switch the default in the onboarding
# "AI models" step. Leave the keys blank to configure a custom provider from
# the UI after activation instead.
# ---------------------------------------------------------------------------

# 'byo' (default) or 'credit' (set automatically once a paid licence is
# applied — do not set to 'credit' by hand).
PRIVOS_LLM_PROVIDER=byo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only set this if ANTHROPIC_API_KEY/OPENAI_API_KEY point at your own
# Anthropic-/OpenAI-compatible endpoint rather than the provider's default.
PRIVOS_LLM_BASE_URL=
# The pre-seeded provider's model names. Required alongside the keys above:
# the gauga/issus/granic aliases are Roxane-gateway-only and a BYO endpoint
# rejects them with a 400. Set these to the REAL model names your provider
# serves, e.g.:
#   PRIVOS_LLM_MODEL=glm-4.6
#   PRIVOS_LLM_SMALL_MODEL=glm-4.5-air
# PRIVOS_LLM_MODEL is the agent's main model; PRIVOS_LLM_SMALL_MODEL is the
# smaller/faster model used for lightweight sub-tasks (defaults to the same
# value as PRIVOS_LLM_MODEL when left blank).
PRIVOS_LLM_MODEL=
PRIVOS_LLM_SMALL_MODEL=

# ---------------------------------------------------------------------------
# Optional sidecar: knowledge-vector (Weaviate) — off by default
#
# Managed knowledge base / semantic search. ~+2 GB RAM (raises the practical
# minimum from 4 GB to 8 GB). --with-knowledge-vector /
# PRIVOS_WITH_KNOWLEDGE_VECTOR=true.
# ---------------------------------------------------------------------------

PRIVOS_WITH_KNOWLEDGE_VECTOR=false
PRIVOS_WEAVIATE_URL=http://weaviate:8080
WEAVIATE_ROOT_KEY=
PRIVOS_WEAVIATE_MEM=2g
PRIVOS_WEAVIATE_CPUS=1

# ---------------------------------------------------------------------------
# App Cluster (community marketplace runtime) — ON by default
#
# Runs marketplace MCP apps as containers on this host, dialing OUT to the
# hub over a tunnel (no inbound port). Needs Docker socket GID
# (`stat -c %g /var/run/docker.sock`; macOS/Docker Desktop: 0, the socket is
# root-owned inside the Desktop VM, and install.sh sets it). --without-app-cluster /
# PRIVOS_WITH_APP_CLUSTER=false opts out.
# ---------------------------------------------------------------------------

PRIVOS_WITH_APP_CLUSTER=true
PRIVOS_DOCKER_SOCKET_GID=
# Community bootstrap pairing (wire-contracts.md (b)) — mutual HMAC challenge
# secret shared with the App Cluster container, compose-local only.
PRIVOS_APP_CLUSTER_BOOTSTRAP_TOKEN=
PRIVOS_APP_CLUSTER_MEM=256m
PRIVOS_APP_CLUSTER_CPUS=1

# ---------------------------------------------------------------------------
# File publisher (published-files renderer)
#
# Serves published files at a public URL. Front the `publisher` service (bound
# to PRIVOS_PUBLISHER_BIND:PRIVOS_PUBLISHER_PORT below) with your OWN reverse
# proxy + TLS on a DEDICATED hostname, then set PRIVOS_PUBLISHER_URL to that
# hostname. It must NOT be the hub's ROOT_URL host — install.sh refuses that,
# because the publisher renders uploaded HTML in a sandboxed origin and
# co-hosting it with the hub would break that isolation. Leave PRIVOS_PUBLISHER_URL
# empty to hide the public publish link entirely.
# ---------------------------------------------------------------------------

PRIVOS_PUBLISHER_URL=
PRIVOS_PUBLISHER_BIND=127.0.0.1
PRIVOS_PUBLISHER_PORT=8558
PRIVOS_PUBLISHER_MEM=256m

# ---------------------------------------------------------------------------
# Compose profile activation — do not hand-edit; install.sh derives this from
# PRIVOS_WITH_KNOWLEDGE_VECTOR / PRIVOS_WITH_APP_CLUSTER above.
# ---------------------------------------------------------------------------

COMPOSE_PROFILES=
