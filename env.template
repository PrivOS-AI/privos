# PrivOS self-hosted bundle — environment file
#
# install.sh writes the REAL `.env` (mode 0600, secrets included) next to
# compose.yml. This template documents every knob; it is never used as-is —
# secrets are generated locally by install.sh and are NEVER shipped filled in.
# Do not commit a filled-in .env anywhere.

# ---------------------------------------------------------------------------
# Core placement
# ---------------------------------------------------------------------------

# Absolute path install.sh was run with (--dir, default /opt/privos). Every
# bind mount in compose.yml is anchored on this value.
PRIVOS_DIR=/opt/privos

# Compose project / container-name prefix and the external Docker network
# install.sh pre-creates (`docker network create`). Stable names so re-runs,
# --upgrade and --uninstall can always find "our" resources.
PRIVOS_PROJECT=privos
PRIVOS_NETWORK=privos-sandbox-net

# Dedicated bridge network for agent VM containers (sandbox-proxy's
# VM_NETWORK) — kept separate from PRIVOS_NETWORK so agent VMs can never
# reach Mongo/Redis/RustFS directly. Also pre-created by install.sh
# (`docker network create --opt com.docker.network.bridge.name=...`); the
# fixed bridge interface name lets docker-user-rules.sh match agent-VM
# traffic without resolving an opaque `br-<network-id>` name at runtime.
PRIVOS_AGENT_NETWORK=privos-agent-net

# Image tag pulled for hub/sandbox-board/sandbox-proxy/sandbox-vm (digests are
# baked into compose.yml at publish time; this only selects the tag family).
PRIVOS_STACK_VERSION=

# Public URL the hub is reachable at (--url, e.g. https://privos.example.com
# or http://<host-ip>:3000 for a bare-IP install). Re-running install.sh with
# a different --url rewrites this and restarts the hub. Locally executed
# marketplace apps call the hub at this URL, so it must be reachable from
# containers on this host (a localhost URL breaks local app execution).
PRIVOS_ROOT_URL=

# Stable per-install identity used as DEPLOYMENT_ID / COLLOC_HUB_ID /
# KNOWLEDGE_WORKSPACE_ID. Generated once by install.sh (uuid), never rotated.
PRIVOS_DEPLOYMENT_ID=

# ---------------------------------------------------------------------------
# Ports (see docs/self-hosted-install.md — only the hub is reachable off-host)
# ---------------------------------------------------------------------------

# Published on 0.0.0.0. --hub-port / PRIVOS_HUB_PORT at install time.
PRIVOS_HUB_PORT=3000

# Loopback-only (127.0.0.1) — operator/installer health checks only.
PRIVOS_BOARD_PORT=8556
PRIVOS_PROXY_PORT=8557
PRIVOS_RUSTFS_PORT=9000

# Loopback-only host-port range for the sandbox VM pool (legacy pool mode —
# see RENDERER-DIFF.md). --vm-port-range / PRIVOS_VM_PORT_RANGE.
PRIVOS_VM_PORT_RANGE=30000-30999

# ---------------------------------------------------------------------------
# MongoDB (single-member replica set, generated locally)
# ---------------------------------------------------------------------------

MONGO_ROOT_USER=privos
MONGO_ROOT_PASSWORD=
# Resolved by install.sh from MONGO_ROOT_USER/PASSWORD — not hand-edited.
MONGO_URL=
MONGO_OPLOG_URL=
MONGODB_URL=
PRIVOS_MONGO_CACHE_GB=1
PRIVOS_MONGO_MEM=1g
PRIVOS_MONGO_CPUS=2

# ---------------------------------------------------------------------------
# RustFS (single node — bundle-only, see RENDERER-DIFF.md)
# ---------------------------------------------------------------------------

RUSTFS_ROOT_USER=privos-root
RUSTFS_ROOT_PASSWORD=
# Scoped service account rustfs-init.sh provisions for hub/board/proxy.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=privos
PRIVOS_RUSTFS_MEM=512m
PRIVOS_RUSTFS_CPUS=1

# ---------------------------------------------------------------------------
# Hub admin + secrets (all generated locally by install.sh)
# ---------------------------------------------------------------------------

ADMIN_PASS=
ADMIN_EMAIL=admin@localhost
REG_TOKEN=
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SANDBOX_API_KEY=
# Encrypts the sandbox proxy's egress-credential catalog at rest — without it
# every bot-key/catalog write fails with "CATALOG_SECRET_KEY is not set".
CATALOG_SECRET_KEY=
# Fail-closed usage-authorization gate (matches the fleet default).
SERVICE_USAGE_AUTHORIZATION_FAIL_CLOSED=true
# encrypted_secrets vault key (32 raw bytes, base64) — without it the hub
# falls back to a plaintext secret store and refuses to pair an App Cluster.
PRIVOS_SECRET_STORE_KEY=
PRIVOS_HUB_MEM=2g
PRIVOS_HUB_CPUS=2
PRIVOS_BOARD_MEM=512m
PRIVOS_BOARD_CPUS=1
PRIVOS_PROXY_MEM=512m
PRIVOS_PROXY_CPUS=1

# ---------------------------------------------------------------------------
# LLM routing
#
# Activation (https://client.privos.io/self-hosted/activate) is required
# before this install is usable at all — see install.sh's printed request
# code. Once activated, the built-in Roxane provider (models gauga/issus/
# granic, served by the PrivOS gateway) is the default, starting with $0
# credit; top up any time at client.privos.io. Roxane cannot be deleted or
# edited — this is enforced by the hub, not by anything in this file.
#
# The four keys below are an OPTIONAL pre-seed, not a required setup step.
# If you fill them in before first boot, the sandbox imports them ONCE as a
# custom provider (never overwriting one you later edit by hand) so you can
# pick it from the onboarding "AI models" step instead of typing a key by
# hand — it does not replace Roxane as the default. Leave them blank to
# configure a custom provider from the UI after activation instead.
# ---------------------------------------------------------------------------

# 'byo' (default) or 'credit' (set automatically once a paid licence is
# applied — do not set to 'credit' by hand).
PRIVOS_LLM_PROVIDER=byo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only set this if ANTHROPIC_API_KEY/OPENAI_API_KEY point at your own
# Anthropic-/OpenAI-compatible endpoint rather than the provider's default.
PRIVOS_LLM_BASE_URL=
# The pre-seeded provider's model names. Required alongside the keys above:
# the gauga/issus/granic aliases are Roxane-gateway-only and a BYO endpoint
# rejects them with a 400. Set these to the REAL model names your provider
# serves, e.g.:
#   PRIVOS_LLM_MODEL=glm-4.6
#   PRIVOS_LLM_SMALL_MODEL=glm-4.5-air
# PRIVOS_LLM_MODEL is the agent's main model; PRIVOS_LLM_SMALL_MODEL is the
# smaller/faster model used for lightweight sub-tasks (defaults to the same
# value as PRIVOS_LLM_MODEL when left blank).
PRIVOS_LLM_MODEL=
PRIVOS_LLM_SMALL_MODEL=

# ---------------------------------------------------------------------------
# Optional sidecar: knowledge-vector (Weaviate) — off by default
#
# Managed knowledge base / semantic search. ~+2 GB RAM (raises the practical
# minimum from 4 GB to 8 GB). --with-knowledge-vector /
# PRIVOS_WITH_KNOWLEDGE_VECTOR=true.
# ---------------------------------------------------------------------------

PRIVOS_WITH_KNOWLEDGE_VECTOR=false
PRIVOS_WEAVIATE_URL=http://weaviate:8080
WEAVIATE_ROOT_KEY=
PRIVOS_WEAVIATE_MEM=2g
PRIVOS_WEAVIATE_CPUS=1

# ---------------------------------------------------------------------------
# App Cluster (community marketplace runtime) — ON by default
#
# Runs marketplace MCP apps as containers on this host, dialing OUT to the
# hub over a tunnel (no inbound port). Needs Docker socket GID
# (`stat -c %g /var/run/docker.sock`). --without-app-cluster /
# PRIVOS_WITH_APP_CLUSTER=false opts out.
# ---------------------------------------------------------------------------

PRIVOS_WITH_APP_CLUSTER=true
PRIVOS_DOCKER_SOCKET_GID=
# Community bootstrap pairing (wire-contracts.md (b)) — mutual HMAC challenge
# secret shared with the App Cluster container, compose-local only.
PRIVOS_APP_CLUSTER_BOOTSTRAP_TOKEN=
PRIVOS_APP_CLUSTER_MEM=256m
PRIVOS_APP_CLUSTER_CPUS=1

# ---------------------------------------------------------------------------
# File publisher (published-files renderer)
#
# Serves published files at a public URL. Front the `publisher` service (bound
# to PRIVOS_PUBLISHER_BIND:PRIVOS_PUBLISHER_PORT below) with your OWN reverse
# proxy + TLS on a DEDICATED hostname, then set PRIVOS_PUBLISHER_URL to that
# hostname. It must NOT be the hub's ROOT_URL host — install.sh refuses that,
# because the publisher renders uploaded HTML in a sandboxed origin and
# co-hosting it with the hub would break that isolation. Leave PRIVOS_PUBLISHER_URL
# empty to hide the public publish link entirely.
# ---------------------------------------------------------------------------

PRIVOS_PUBLISHER_URL=
PRIVOS_PUBLISHER_BIND=127.0.0.1
PRIVOS_PUBLISHER_PORT=8558
PRIVOS_PUBLISHER_MEM=256m

# ---------------------------------------------------------------------------
# Compose profile activation — do not hand-edit; install.sh derives this from
# PRIVOS_WITH_KNOWLEDGE_VECTOR / PRIVOS_WITH_APP_CLUSTER above.
# ---------------------------------------------------------------------------

COMPOSE_PROFILES=
