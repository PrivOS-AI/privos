# PrivOS Parser, self-host settings. Copy to .env (mode 0600) and fill in.
# Lines left empty are required unless a default is stated.

# Compose files. The default fits a Community Edition bundle on the same host.
# For a Hub on another host use COMPOSE_FILE=compose.parser.yml
COMPOSE_FILE=compose.parser.yml:compose.parser.same-host.yml
# Name of the Docker network the Hub bundle runs on (same-host layout only).
PRIVOS_NETWORK=privos-sandbox-net

# --- Access -----------------------------------------------------------------
# The key the Hub sends. Exactly 64 lowercase hex characters:
#   openssl rand -hex 32
PARSER_API_KEY=
# Published on this address and port of the host (loopback by default). Put a
# TLS reverse proxy in front before binding a non-loopback address.
PARSER_BIND_ADDRESS=127.0.0.1
PARSER_PORT=8000

# --- Vision API (any OpenAI-compatible server that accepts images) ----------
# Base URL with or without a trailing /v1, for example https://api.openai.com
VISION_API_BASE_URL=
# Model name as the server knows it, for example gpt-4o-mini
VISION_API_MODEL=
# API key. Leave empty for a local server that needs none.
VISION_API_KEY=
# Parallel page reads sent to the vision API.
VISION_API_MAX_CONCURRENCY=4
# Output limit per page. Must not exceed the model's own limit.
VISION_API_MAX_TOKENS=8192
VISION_API_TIMEOUT_SECONDS=300
# Extra JSON fields for the request body. Leave empty ({}) for hosted APIs;
# set it only for servers that need them, for example vLLM:
#   {"chat_template_kwargs":{"enable_thinking":false}}
VISION_API_EXTRA_BODY={}

# --- Storage: the Hub's S3-compatible bucket --------------------------------
# Copy these from the .env of your Hub bundle: RUSTFS_ACCESS_KEY,
# RUSTFS_SECRET_KEY and RUSTFS_BUCKET. The endpoint is host:port, no scheme.
RUSTFS_ENDPOINT=privos-rustfs:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=privos
RUSTFS_SECURE=false

# --- State services in this stack -------------------------------------------
# Password for the bundled MongoDB. Use hex so it needs no URL encoding:
#   openssl rand -hex 24
MONGO_PASSWORD=

# --- Sizing -----------------------------------------------------------------
PARSER_WORKER_CONCURRENCY=2
PARSER_MEM=3g
PARSER_CPUS=2
